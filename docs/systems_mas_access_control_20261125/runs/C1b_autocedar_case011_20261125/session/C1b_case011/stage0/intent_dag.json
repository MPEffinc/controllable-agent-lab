      "text": "Pull Request Merge Access",
      "start_line": 1,
      "end_line": 1,
      "heading_path": [],
      "node_type": "requirement",
      "parent_id": null,
      "ordinal": 1,
      "kind": "source"
    },
    {
      "id": "src.root.p0002.l3",
      "text": "A user may merge a pull request only if the user holds the maintainer role, is not the pull request\u2019s author, and is using the VPN.",
      "start_line": 3,
      "end_line": 3,
      "heading_path": [],
      "node_type": "requirement",
      "parent_id": null,
      "ordinal": 2,
      "kind": "source"
    },
    {
      "id": "src.root.p0003.l3",
      "text": "The pull request must have at least one approval, and its target branch name must begin with \u201chotfix/\u201d.",
      "start_line": 3,
      "end_line": 3,
      "heading_path": [],
      "node_type": "requirement",
      "parent_id": null,
      "ordinal": 3,
      "kind": "source"
    },
    {
      "id": "src.root.p0004.l5",
      "text": "These are the only permissions: merging is allowed when all these requirements are met; otherwise it is denied, and no other actions are permitted.",
