  "quotes": [
    {
      "id": "VERA-1",
      "paper": "vera",
      "arxiv_id": "2608.30091",
      "quote": "It does not cover threshold approval or all-parent approval; those policies require different target functions.",
      "found_verbatim": true,
      "char_offset": 12879
    },
    {
      "id": "VERA-2",
      "paper": "vera",
      "arxiv_id": "2608.30091",
      "quote": "A node with an alternate authorizing root path must stay active.",
      "found_verbatim": true,
      "char_offset": 14991
    },
    {
      "id": "VERA-3",
      "paper": "vera",
      "arxiv_id": "2608.30091",
      "quote": "hot-path authorization uses cached verified revocation state",
      "found_verbatim": true,
      "char_offset": 37281
    },
    {
      "id": "VERA-4",
      "paper": "vera",
      "arxiv_id": "2608.30091",
      "quote": "The artifact is available at",
      "found_verbatim": true,
      "char_offset": 41731
    },
    {
      "id": "VERA-5",
      "paper": "vera",
      "arxiv_id": "2608.30091",
      "quote": "None directly provides a multi-parent, cross-domain edge target",
      "found_verbatim": true,
      "char_offset": 40414
    },
    {
      "id": "VERA-6",
      "paper": "vera",
      "arxiv_id": "2608.30091",
      "quote": "the edge target preserves the shared agent in all 320 cases while tree cascade revokes it in all 320",
      "found_verbatim": true,
      "char_offset": 29994
    },
    {
      "id": "VERA-7",
      "paper": "vera",
      "arxiv_id": "2608.30091",
      "quote": "APS is closest among agent proposals but uses a single-parent rooted tree",
      "found_verbatim": true,
      "char_offset": 40331
    },
    {
      "id": "REV-1",
      "paper": "revocation",
      "arxiv_id": "2609.21284",
      "quote": "A carrier may have conjunctive requirements and alternative roots.",
      "found_verbatim": true,
      "char_offset": 40596
    },
    {
      "id": "REV-2",
      "paper": "revocation",
      "arxiv_id": "2609.21284",
      "quote": "Treating its roots as a flat union would over-revoke independently authorized work; treating them as an existential set would permit root laundering.",
      "found_verbatim": true,
      "char_offset": 40663
    },
    {
      "id": "REV-3",
      "paper": "revocation",
      "arxiv_id": "2609.21284",
      "quote": "It neither declares the whole system idle nor revokes work supported by other roots.",
      "found_verbatim": true,
      "char_offset": 7993
    },
    {
      "id": "REV-4",
      "paper": "revocation",
      "arxiv_id": "2609.21284",
      "quote": "a strict subset of a conjunctive witness cannot authorize an effect",
      "found_verbatim": true,
      "char_offset": 75045
    },
    {
      "id": "REV-5",
      "paper": "revocation",
      "arxiv_id": "2609.21284",
      "quote": "Registry and manifest completeness",
      "found_verbatim": true,
      "char_offset": 31599
    },
    {
      "id": "REV-6",
      "paper": "revocation",
      "arxiv_id": "2609.21284",
      "quote": "Issuer mediation and non-expansion",
      "found_verbatim": true,
      "char_offset": 29831
    },
    {
      "id": "REV-7",
      "paper": "revocation",
      "arxiv_id": "2609.21284",
      "quote": "Theorem 12 (Independent-support preservation)",
      "found_verbatim": true,
      "char_offset": 60224
    },
    {
      "id": "REV-8",
      "paper": "revocation",
      "arxiv_id": "2609.21284",
      "quote": "Theorem 14 (Crash/replay stability and unrelated-root locality)",
      "found_verbatim": true,
      "char_offset": 61008
    },
    {
      "id": "REV-9",
      "paper": "revocation",
      "arxiv_id": "2609.21284",
      "quote": "Exact delegation-edge revocation the authority consequences of removing a selected graph edge",
      "found_verbatim": true,
      "char_offset": 14912
    },
    {
      "id": "REV-10",
      "paper": "revocation",
      "arxiv_id": "2609.21284",
      "quote": "The evaluated system is the executable durable-ledger artifact, its 17-case late-effect test suite, and the separately implemented checker.",
      "found_verbatim": true,
      "char_offset": 90652
    },
    {
      "id": "REV-11",
      "paper": "revocation",
      "arxiv_id": "2609.21284",
      "quote": "represents alternative and conjunctive authority as antichains of minimal sufficient root sets",
      "found_verbatim": true,
      "char_offset": 4305
    },
    {
      "id": "SUC-1",
      "paper": "succession",
      "arxiv_id": "2610.00347",
      "quote": "The core transition system admits no multi-parent child and no merge rule.",
      "found_verbatim": true,
      "char_offset": 37767
    },
    {
      "id": "SUC-2",
      "paper": "succession",
      "arxiv_id": "2610.00347",
      "quote": "Multi-parent authority merge is outside the formal, implemented, and executed result.",
      "found_verbatim": true,
      "char_offset": 120925
    },
    {
      "id": "SUC-3",
      "paper": "succession",
      "arxiv_id": "2610.00347",
      "quote": "such coordination does not create an authorization parent edge or union their grants",
      "found_verbatim": true,
      "char_offset": 18048
    },
    {
      "id": "SUC-4",
      "paper": "succession",
      "arxiv_id": "2610.00347",
      "quote": "Executable artifacts, adapters, checker traces, temporary files, source caches, and non-manuscript research materials remain outside that archive.",
      "found_verbatim": true,
      "char_offset": 125109
    },
    {
      "id": "SUC-5",
      "paper": "succession",
      "arxiv_id": "2610.00347",
      "quote": "Our protocol assumes such complete mediation",
      "found_verbatim": true,
      "char_offset": 116389
    },
    {
      "id": "SUC-6",
      "paper": "succession",
      "arxiv_id": "2610.00347",
      "quote": "conserves authority across a single-parent generation forest",
      "found_verbatim": true,
      "char_offset": 4203
    },
    {
      "id": "RES-1",
      "paper": "residualauth",
      "arxiv_id": "2609.08062",
      "quote": "an optional immutable selected parent",
      "found_verbatim": true,
      "char_offset": 115112
    },
    {
      "id": "RES-2",
      "paper": "residualauth",
      "arxiv_id": "2609.08062",
      "quote": "Cascading effectiveness is the well-founded recursion",
      "found_verbatim": true,
      "char_offset": 116305
    },
    {
      "id": "RES-3",
      "paper": "residualauth",
      "arxiv_id": "2609.08062",
      "quote": "A hard gate separately checks proposals against a trusted ledger before execution",
      "found_verbatim": true,
      "char_offset": 10615
    },
    {
      "id": "RES-4",
      "paper": "residualauth",
      "arxiv_id": "2609.08062",
      "quote": "not an end-to-end replay of the experiment repository",
      "found_verbatim": true,
      "char_offset": 41417
    },
    {
      "id": "CON-1",
      "paper": "continuity",
      "arxiv_id": "2609.05269",
      "quote": "Authority and delegation can increase only through a separately authenticated grant",
      "found_verbatim": true,
      "char_offset": 34414
    },
    {
      "id": "CON-2",
      "paper": "continuity",
      "arxiv_id": "2609.05269",
      "quote": "only a verified grant edge may add authority",
      "found_verbatim": true,
      "char_offset": 36458
    },
    {
      "id": "CON-3",
      "paper": "continuity",
      "arxiv_id": "2609.05269",
      "quote": "Key rotation, quorum authorization, hardware roots, and certificate-path validation are outside the prototype.",
      "found_verbatim": true,
      "char_offset": 73279
    },
    {
      "id": "CON-4",
      "paper": "continuity",
      "arxiv_id": "2609.05269",
      "quote": "Complete mediation is an engineering and governance obligation.",
      "found_verbatim": true,
      "char_offset": 76206
    },
    {
      "id": "CON-5",
      "paper": "continuity",
      "arxiv_id": "2609.05269",
      "quote": "A permit issued before a grant is revoked is rejected at finality.",
      "found_verbatim": true,
      "char_offset": 44601
    },
    {
      "id": "CON-6",
      "paper": "continuity",
      "arxiv_id": "2609.05269",
      "quote": "The proof protects only sinks that require a valid permit.",
      "found_verbatim": true,
      "char_offset": 44691
    },
    {
      "id": "CON-7",
      "paper": "continuity",
      "arxiv_id": "2609.05269",
      "quote": "A deployment must enumerate protected effect classes",
      "found_verbatim": true,
      "char_offset": 44750
    },
    {
      "id": "VERA-8",
      "paper": "vera",
      "arxiv_id": "2608.30091",
      "quote": "Simultaneous revocations must yield the exact joint target, not necessarily the union of single-edge targets.",
      "found_verbatim": true,
      "char_offset": 15320
    },
    {
      "id": "REV-12",
      "paper": "revocation",
      "arxiv_id": "2609.21284",
      "quote": "No descendant inherits the rebind merely from ancestry; it must either be covered by the same atomic profile transition or carry its own receipt.",
      "found_verbatim": true,
      "char_offset": 44480
    },
    {
      "id": "REV-13",
      "paper": "revocation",
      "arxiv_id": "2609.21284",
      "quote": "obligations and carrier effects already emitted before or across the revocation cut",
      "found_verbatim": true,
      "char_offset": 15006
    },
    {
      "id": "SUC-7",
      "paper": "succession",
      "arxiv_id": "2610.00347",
      "quote": "Ancestor cuts invalidate dependent descendants; rollback creates a fresh generation without restoring spent authority; a new root requires an independent grant.",
      "found_verbatim": true,
      "char_offset": 4727
    },
    {
      "id": "RES-5",
      "paper": "residualauth",
      "arxiv_id": "2609.08062",
      "quote": "an idempotent grant never reparents an authorized target",
      "found_verbatim": true,
      "char_offset": 58316
    },
    {
      "id": "RES-6",
      "paper": "residualauth",
      "arxiv_id": "2609.08062",
      "quote": "One parent per record does not mean one incoming grant per principal.",
      "found_verbatim": true,
      "char_offset": 26770
    }
  ],
