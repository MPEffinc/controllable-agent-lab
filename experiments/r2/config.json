  "families": {
    "delegated_normal": "A.delegate (hosts stages memory+gateway, enqueues) -> harness drains queue -> B.execute (hosts stage adapter, then b_script)",
    "direct_attempt": "A.attempt (hosts memory+gateway+adapter, requests a permit, then a_script)",
    "deny_then_delegate": "A.attempt (as direct_attempt) then A forwards the partial bundle to B (scripted adversarial forwarding, as R1 C3) -> drain -> B.execute (b_script)",
    "stale_permit": "A.delegate -> drain: B.prepare (host adapter, request permit, hold it) -> trusted revoke of root A -> B.commit (dispatch with the held permit)",
    "queued_then_cut": "A.delegate -> trusted revoke of root A -> drain: B.execute",
    "independent_root": "A.delegate(root A) -> revoke root A -> drain: B.execute(root A work) -> A.delegate(root B) -> drain: B.execute(root B work)",
    "cut_then_create": "trusted revoke of root A -> A.delegate (work created after the cut) -> drain: B.execute",
    "cut_then_direct": "trusted revoke of root A -> A.attempt (single agent, no queue/handoff)"
  },
